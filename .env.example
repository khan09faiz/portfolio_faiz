# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values, and never prefix a secret with NEXT_PUBLIC_ (that ships it to the
# browser).

# ---------------------------------------------------------------------------
# Database — Neon Postgres (optional)
# ---------------------------------------------------------------------------
# Leave unset and the site reads content from src/data/*.json instead. Nothing
# breaks without it; the CMS simply has nothing to write to.
#
# Get one from https://console.neon.tech -> your project -> Connection string.
# Use the POOLED connection string (it contains "-pooler"), which is the right
# one for serverless functions.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin authentication — Auth.js with GitHub (not wired up yet)
# ---------------------------------------------------------------------------
# Create at https://github.com/settings/developers -> New OAuth App
#   Homepage URL:              https://portfolio-faiz-nu.vercel.app
#   Authorization callback URL https://portfolio-faiz-nu.vercel.app/api/auth/callback/github
# For local development add a second app pointing at http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Only this GitHub login may reach the admin. Anyone else authenticates
# successfully with GitHub and is then refused.
ADMIN_GITHUB_LOGIN=khan09faiz

# ---------------------------------------------------------------------------
# Already configured in Vercel — listed for local development
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_USERNAME=khan09faiz
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
